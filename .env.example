# Google Tag Manager container ID
# Defaults to the production GTM container. Override per environment if needed.
NEXT_PUBLIC_GTM_ID=GTM-NWRCP5VH

# First-party forms proxy. n8n webhook URLs must never be public environment vars.
NEXT_PUBLIC_FORMS_ENDPOINT=https://sealmetrics-forms.sealmetrics-forms-worker.workers.dev/api/forms
NEXT_PUBLIC_LEAD_TURNSTILE_SITE_KEY=replace-with-public-site-key
