{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sealmetrics-forms",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://sealmetrics.com,https://www.sealmetrics.com",
    "ENROUTIA_API_BASE": "https://platform.enroutia.com",
    "TURNSTILE_HOSTNAMES": "sealmetrics.com,www.sealmetrics.com",
    "TURNSTILE_ACTION": "sealmetrics_lead",
    // The free brand check has its own widget action, so a lead-form token
    // cannot be replayed against it (and the other way round).
    "BRAND_CHECK_TURNSTILE_ACTION": "sealmetrics_brand_check",
    "REQUIRE_TURNSTILE": "true"
  },
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "19081",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "BRAND_CHECK_READ_LIMITER",
      "namespace_id": "19082",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // Full brand reports behind the private link in the email, 30-day TTL.
  // See README, "Full brand report link".
  "kv_namespaces": [
    {
      "binding": "BRAND_REPORTS",
      "id": "5f368ea091684298bddf2cf1f946ef4e"
    }
  ]
}
